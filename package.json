{
  "name": "wapp-manager-pro",
  "version": "2026.5.0",
  "productName": "WApp Manager Pro",
  "author": "DreamaniaCode",
  "description": "WApp Manager Pro by DreamaniaCode",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "backend": "node backend.js",
    "electron:dev": "electron .",
    "electron:start": "electron .",
    "build": "next build",
    "dist": "electron-builder"
  },
  "build": {
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@prisma/**",
      "**/node_modules/.prisma/**"
    ],
    "appId": "com.dreamaniacode.wappmanager",
    "productName": "WApp Manager Pro",
    "copyright": "Copyright © 2026 DreamaniaCode",
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico",
      "legalTrademarks": "DreamaniaCode",
      "cscLink": "dreamaniacode.pfx",
      "cscKeyPassword": "Dreamania2026!",
      "forceCodeSigning": false,
      "verifyUpdateCodeSignature": false,
      "signtoolOptions": {
        "publisherName": "DreamaniaCode",
        "rfc3161TimeStampServer": "http://timestamp.sectigo.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "WApp Manager Pro",
      "artifactName": "WApp Manager Pro Setup ${version}.${ext}",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "warningsAsErrors": false,
      "include": "build/installer.nsh"
    },
    "extraFiles": [
      {
        "from": "node_modules/.prisma",
        "to": "resources/app.asar.unpacked/node_modules/.prisma"
      },
      {
        "from": "public/icon.ico",
        "to": "app.ico"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "backend.js",
      "chatbot_rag.js",
      "learned_knowledge.json",
      "rag_sources.json",
      "rag_chunks.json",
      "package.json",
      "out/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/fs-extra": "^11.0.4",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.1",
    "cookie": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "fs-extra": "^11.3.3",
    "lucide-react": "^0.564.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "papaparse": "^5.5.3",
    "pg": "^8.18.0",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.7.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "wait-on": "^9.0.4"
  }
}
