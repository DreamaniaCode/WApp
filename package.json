{
  "name": "temp_app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:custom": "concurrently \"npm run dev\" \"npm run backend\"",
    "build:backend": "tsc --project tsconfig.server.json",
    "backend": "nodemon --exec ts-node --project tsconfig.server.json backend.ts",
    "build": "next build && npm run build:backend",
    "start": "next start",
    "start:custom": "concurrently \"npm run start\" \"node dist/backend.js\"",
    "lint": "eslint"
  },
  "dependencies": {
    "@types/papaparse": "^5.5.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.564.0",
    "next": "15.5.7",
    "papaparse": "^5.5.3",
    "qrcode.react": "^4.2.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "whatsapp-web.js": "^1.34.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "eslint": "^9",
    "eslint-config-next": "15.5.7",
    "nodemon": "^3.1.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}